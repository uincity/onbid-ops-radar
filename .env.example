# OnBid Ops Radar 환경변수 목록 (이름만 적은 견본 — 실제 값은 절대 넣지 않는다)
# 사용법: 이 이름들이 .env.local에 모두 있어야 앱이 동작한다.
#   - 대부분은 `npm run setup:env`가 자동으로 채운다.
#   - 배포할 때는 Vercel 환경변수에도 같은 이름으로 등록한다. (PRD 7-3)
# 이름이 NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 공개된다. 그 밖의 값은 서버 전용이다.

# --- 브라우저·서버 공용 (공개되어도 되는 값) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 서버 전용 (브라우저 코드에서 사용 금지) ---
# Supabase 관리용 키: 예약 점검·수동 점검·관리 스크립트에서만 사용
SUPABASE_SECRET_KEY=
# 공공데이터포털 온비드 OpenAPI 서비스키: 활용신청 승인 후 직접 입력
DATA_GO_KR_SERVICE_KEY=
# 예약 점검 입구(/api/cron/daily-check) 인증용 비밀값
CRON_SECRET=

# --- 개발 도구용 (앱 코드에서는 사용하지 않음, scripts/ 에서만 사용) ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
