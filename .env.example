# OnBid Ops Radar 환경변수 목록 (이름만 적은 견본 — 실제 값은 절대 넣지 않는다)
# 사용법: 이 이름들이 .env 파일에 모두 있어야 한다. (.env는 GitHub에 올라가지 않는다)
#   - 앱용 값은 대부분 `npm run setup:env`가 자동으로 채운다.
#   - 이름이 NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 공개된다. 그 밖의 값은 서버 전용이다.
#
# 배포(Vercel)할 때는 "앱용" 변수만 Vercel 환경변수에 같은 이름으로 등록한다. (PRD 7-3)
#   → 아래 "개발 도구용" 변수는 이 컴퓨터에서만 쓰며 Vercel에 등록하지 않는다.

# =====================================================================
# 개발 도구용 (이 컴퓨터에서 CLI 로그인에만 사용, 앱 코드에서는 사용하지 않음, Vercel에 등록 금지)
# =====================================================================
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
# MVP에서는 LLM을 쓰지 않으므로 앱 코드에서 사용하지 않는다
OPENAI_API_KEY=
# Supabase 프로젝트 연결 정보 (npm run setup:supabase가 기록, scripts/에서만 사용)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# 시연·테스트 계정 2개 (가상 이메일·가상 데이터 전용, npm run setup:accounts가 만들고 기록, 화면 시연·Playwright 로그인에 사용)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=

# =====================================================================
# 앱용 (Vercel 환경변수에도 같은 이름으로 등록)
# =====================================================================
# --- 브라우저·서버 공용 (공개되어도 되는 값) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 서버 전용 (브라우저 코드에서 사용 금지) ---
# Supabase 관리용 키: 예약 점검·수동 점검·관리 스크립트에서만 사용
SUPABASE_SECRET_KEY=
# 공공데이터포털 온비드 OpenAPI 서비스키: 활용신청 승인 후 직접 입력
DATA_GO_KR_SERVICE_KEY=
# 예약 점검 입구(/api/cron/daily-check) 인증용 비밀값
CRON_SECRET=
